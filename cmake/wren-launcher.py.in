#!/usr/bin/env python3
"""Launch the installed Wren command from its relocatable CMake prefix."""
from importlib.metadata import distribution
from pathlib import Path
import sys

sys.path.insert(0, str((Path(__file__).resolve().parent / '@WREN_PYTHON_FROM_BIN@').resolve()))
entry = distribution('wren').entry_points.select(group='console_scripts', name=Path(__file__).name)
raise SystemExit(next(iter(entry)).load()())
